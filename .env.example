# --- Required -----------------------------------------------------------
# football-data.org v4 token (free tier works). https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- Upstash Redis ------------------------------------------------------
# Installing "Upstash for Redis" from the Vercel Marketplace injects KV_REST_API_URL / KV_REST_API_TOKEN.
# If you created the database on upstash.com directly, use the UPSTASH_* names instead. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional -----------------------------------------------------------
# football-data plan: "free" marks scores as possibly delayed and keeps the 10 req/min budget.
FOOTBALL_DATA_PLAN=free
# Override the outgoing football-data budget (requests per minute). Defaults: free=8, standard=28, higher=55.
# FOOTBALL_DATA_RPM=8

# API-Football (api-sports.io). OFF by default; the app works without it.
ENABLE_API_FOOTBALL=false
API_FOOTBALL_KEY=
# Outgoing API-Football budget. The free plan allows 100 requests/day; keep some headroom.
API_FOOTBALL_DAILY_BUDGET=90
API_FOOTBALL_RPM=8

# OpenLigaDB (openligadb.de): free and keyless. Serves 2. Bundesliga and the DFB-Pokal,
# and stands in for the Bundesliga when football-data.org is down. ON unless set to false.
# ENABLE_OPENLIGADB=true
# OpenLigaDB publishes no limit; this is our own politeness budget.
# OPENLIGADB_RPM=30

# Per-IP request limit for this API (requests per minute, per IP, shared via Redis).
IP_RATE_LIMIT_PER_MINUTE=120

# Vercel sets CRON_SECRET for cron invocations if you define it in project settings.
CRON_SECRET=
