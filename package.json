{
  "name": "pitchside-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MatchBell API: normalized football fixtures, results and tables for the MatchBell app",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "dev:local": "tsx watch scripts/local-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run check",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
